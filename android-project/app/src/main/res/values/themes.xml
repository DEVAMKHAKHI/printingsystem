<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PrintCare" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/printcare_blue_primary</item>
        <item name="colorOnPrimary">@color/printcare_white</item>
        <item name="colorPrimaryContainer">@color/printcare_blue_light</item>
        <item name="colorOnPrimaryContainer">@color/printcare_blue_dark</item>
        <item name="colorSecondary">@color/printcare_blue_dark</item>
        <item name="colorOnSecondary">@color/printcare_white</item>
        <item name="android:colorBackground">@color/printcare_background</item>
        <item name="colorSurface">@color/printcare_surface</item>
        <item name="colorOnSurface">@color/printcare_text_primary</item>
        <item name="colorError">@color/printcare_error</item>
        <item name="android:statusBarColor">@color/printcare_blue_dark</item>
    </style>

    <style name="Widget.PrintCare.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/printcare_blue_primary</item>
    </style>

    <style name="Widget.PrintCare.PrimaryButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.PrintCare.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="strokeColor">@color/printcare_border</item>
    </style>
</resources>
