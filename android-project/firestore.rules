rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: ensure user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: validate customer document schema & field types
    function isValidCustomer(data) {
      return data.keys().hasAll([
          'customerId', 'name', 'phone', 'dob', 'email', 'address', 'createdAt'
        ])
        && data.keys().hasOnly([
          'customerId', 'name', 'phone', 'dob', 'email', 'address', 'createdAt'
        ])
        && data.customerId is string && data.customerId.size() > 0
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.phone is string && data.phone.matches('^[6-9][0-9]{9}$')
        && data.dob is string && data.dob.matches('^[0-9]{2}/[0-9]{2}/[0-9]{4}$')
        && data.email is string && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.address is string && data.address.size() >= 5 && data.address.size() <= 400
        && data.createdAt is timestamp;
    }

    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.customerId == customerId
                    && isValidCustomer(request.resource.data);
      allow update: if isAuthenticated()
                    && request.resource.data.customerId == customerId
                    && isValidCustomer(request.resource.data);
      allow delete: if isAuthenticated();
    }

    // Deny access to all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
